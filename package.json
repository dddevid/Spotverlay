{
  "name": "spotverlay",
  "productName": "Spotverlay",
  "version": "1.0.0",
  "description": "Always-on-top music overlay for Windows that reads Spotify playback via SMTC — no API key, no DLL injection.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.spotverlay.app",
    "productName": "Spotverlay",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "scripts/**/*"
    ]
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
